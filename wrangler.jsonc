{
  "name": "msedlackova-admin",
  "compatibility_date": "2025-06-05",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    // /admin* a /api/* musí vždy obsloužit Worker – bez toho je může
    // asset vrstva zachytit dřív (a přes not_found_handling vrátit
    // homepage) nebo je zacachovat na edge se špatným obsahem.
    "run_worker_first": ["/admin", "/admin/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "msedlackova-booking",
      "database_id": "bbbed9c7-28f4-4b94-aad3-e61d80590bc0"
    }
  ],
  "routes": [
    { "pattern": "michaelasedlackova.info/*", "zone_name": "michaelasedlackova.info" }
  ]
}
